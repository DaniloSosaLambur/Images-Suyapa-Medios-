{
    "version": 2,
    "builds": [
        {
          "src": "www.js",
          "use": "@vercel/node"
        }
      ],
    "routes": [
        {
          "src": "/api/(.*)",
          "dest": "www.js"
        },
        {
          "src": "/(.*)",
          "dest": "www.js"
        }
      ]
  }